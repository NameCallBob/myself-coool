{
  "compilerOptions": {
    // ES2020 for BigInt literals: the radix converter needs arbitrary-precision
    // integers, and Next.js targets Chrome/Edge/Firefox 111+ and Safari 16.4+,
    // all of which have had BigInt for years. tsc emits nothing here (noEmit),
    // so this only governs which syntax the type-checker accepts.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Unit tests run on `node --test` with Node's own type stripping, which
    // needs the real specifier — `./random.ts`, not `./random`. Allowed here
    // because this project never emits from tsc (noEmit above).
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
