{
  "name": "binbinbob-work",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/build-pwa.mjs",
    "content:dates": "node scripts/content-dates.mjs --write",
    "dev": "next dev",
    "fonts": "node scripts/subset-fonts.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "eslint",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-tool-loader.mjs",
    "serve": "node scripts/serve-out.mjs",
    "shots": "node scripts/shots.mjs",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/tools/**/*.test.ts\" \"src/lib/**/*.test.ts\"",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
